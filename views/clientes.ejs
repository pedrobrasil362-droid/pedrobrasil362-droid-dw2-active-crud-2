<%- include ('partials/header.ejs') %>
<%- include ('partials/navbar.ejs') %>

<main class="page-shell">
    <section class="panel">
        <div class="panel-heading">
            <span class="card-icon">🎮</span>
            <div>
                <h1>Recrutar jogador</h1>
                <p>Adicione um novo competidor ao seu esquadrão.</p>
            </div>
        </div>
        <div class="panel-body">
            <form action="/clientes/cadastrar" method="POST">
                <div class="form-grid">
                    <div class="form-group">
                        <label for="nome">Nick do jogador</label>
                        <input type="text" name="nome" id="nome" placeholder="Ex.: LendaDaArena" class="form-control" required>
                    </div>
                    <div class="form-group">
                        <label for="cpf">ID de jogador</label>
                        <input type="text" name="cpf" id="cpf" placeholder="Insira o ID do jogador" class="form-control" required>
                    </div>
                    <div class="form-group">
                        <label for="endereco">Clube / região</label>
                        <input type="text" name="endereco" id="endereco" placeholder="Ex.: Clube Estelar" class="form-control" required>
                    </div>
                </div>
                <div class="form-actions">
                    <button type="submit" class="btn btn-success">+ Adicionar jogador</button>
                    <button type="reset" class="btn btn-secondary">Limpar</button>
                </div>
            </form>
        </div>
    </section>

    <section class="panel">
        <div class="panel-heading">
            <span class="card-icon">🏆</span>
            <div>
                <h2>Esquadrão de jogadores</h2>
                <p>Competidores cadastrados na arena.</p>
            </div>
        </div>
        <div class="panel-body table-wrap">
            <table class="table table-hover">
                <thead>
                    <tr><th></th><th>Nick</th><th>ID de jogador</th><th>Clube / região</th></tr>
                </thead>
                <tbody>
                    <% if (clientes.length === 0) { %>
                        <tr><td colspan="4" class="empty-state">Ainda não há jogadores no esquadrão. Recrute o primeiro!</td></tr>
                    <% } %>
                    <% clientes.forEach(cliente => { %>
                        <tr>
                            <td><img src="imgs/avatar.png" class="table-icon" alt=""></td>
                            <td><%= cliente.nome %></td>
                            <td><%= cliente.cpf %></td>
                            <td><%= cliente.endereco %></td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </section>
</main>

<%- include ('partials/footer.ejs') %>