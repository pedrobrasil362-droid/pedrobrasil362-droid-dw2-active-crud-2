<%- include ('partials/header.ejs') %>
<%- include ('partials/navbar.ejs') %>

<main class="page-shell">
    <section class="panel">
        <div class="panel-heading">
            <span class="card-icon">⚔️</span>
            <div>
                <h1>Preparar partida</h1>
                <p>Registre um novo confronto para o seu esquadrão.</p>
            </div>
        </div>
        <div class="panel-body">
            <form method="POST" action="/partidas/cadastrar">
                <div class="form-grid">
                    <div class="form-group">
                        <label for="numero">Número da partida</label>
                        <input type="number" name="numero" id="numero" min="1" placeholder="Ex.: 001" class="form-control" required>
                    </div>
                    <div class="form-group">
                        <label for="recompensa">Recompensa (troféus)</label>
                        <input type="number" name="recompensa" id="recompensa" min="0" step="0.01" placeholder="Ex.: 8" class="form-control" required>
                    </div>
                    <div class="form-group">
                        <label for="jogador_id">Jogador do esquadrão</label>
                        <select name="jogador_id" id="jogador_id" class="form-control" required>
                            <option value="" selected disabled>Selecione um jogador</option>
                            <% jogadores.forEach(jogador => { %>
                                <option value="<%= jogador.id %>"><%= jogador.nick %></option>
                            <% }) %>
                        </select>
                    </div>
                </div>
                <div class="form-actions">
                    <button type="submit" class="btn btn-success">+ Registrar partida</button>
                </div>
            </form>
        </div>
    </section>

    <section class="panel">
        <div class="panel-heading">
            <span class="card-icon">🏆</span>
            <div>
                <h2>Histórico de partidas</h2>
                <p>Confrontos registrados na arena.</p>
            </div>
        </div>
        <div class="panel-body table-wrap">
            <table class="table table-hover">
                <thead>
                    <tr><th></th><th>Partida</th><th>Recompensa</th><th>Jogador</th><th>ID de jogador</th><th>Ações</th></tr>
                </thead>
                <tbody>
                    <% if (partidas.length === 0) { %>
                        <tr><td colspan="6" class="empty-state">Nenhuma partida registrada. A próxima vitória pode ser sua!</td></tr>
                    <% } %>
                    <% partidas.forEach(partida => { %>
                        <tr>
                            <td><img src="imgs/order.png" class="table-icon" alt=""></td>
                            <td>#<%= partida.numero %></td>
                            <td>🏆 <%= Number(partida.recompensa).toLocaleString('pt-br', { maximumFractionDigits: 2 }) %></td>
                            <td><%= partida.jogador.nick %></td>
                            <td><%= partida.jogador.id_jogador %></td>
                            <td>
                                <div class="table-actions">
                                    <a href="/partidas/<%= partida.id %>/editar" class="btn btn-secondary">Editar</a>
                                    <form action="/partidas/<%= partida.id %>/excluir" method="POST" onsubmit="return confirm('Tem certeza que deseja excluir esta partida?')">
                                        <button type="submit" class="btn btn-danger">Excluir</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </section>
</main>

<%- include ('partials/footer.ejs') %>
