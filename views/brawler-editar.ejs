<%- include ('partials/header.ejs') %>
<%- include ('partials/navbar.ejs') %>

<main class="page-shell">
    <section class="panel">
        <div class="panel-heading">
            <span class="card-icon">⭐</span>
            <div>
                <h1>Editar brawler</h1>
                <p>Atualize os dados de <%= brawler.nome %>.</p>
            </div>
        </div>
        <div class="panel-body">
            <form action="/brawlers/<%= brawler.id %>/atualizar" method="POST">
                <div class="form-grid">
                    <div class="form-group">
                        <label for="nome">Nome do brawler</label>
                        <input type="text" name="nome" id="nome" value="<%= brawler.nome %>" class="form-control" required>
                    </div>
                    <div class="form-group">
                        <label for="poder">Poder (moedas)</label>
                        <input type="number" name="poder" id="poder" min="0" step="0.01" value="<%= brawler.poder %>" class="form-control" required>
                    </div>
                    <div class="form-group">
                        <label for="classe">Classe</label>
                        <input type="text" name="classe" id="classe" value="<%= brawler.classe %>" class="form-control" required>
                    </div>
                </div>
                <div class="form-actions">
                    <button type="submit" class="btn btn-success">Salvar alterações</button>
                    <a href="/brawlers" class="btn btn-secondary">Cancelar</a>
                </div>
            </form>
        </div>
    </section>
</main>

<%- include ('partials/footer.ejs') %>
