<%- include ('partials/header.ejs') %>
<%- include ('partials/navbar.ejs') %>

<main class="page-shell">
    <section class="panel">
        <div class="panel-heading">
            <span class="card-icon">⚔️</span>
            <div>
                <h1>Preparar partida</h1>
                <p>Registre um novo confronto para o seu esquadrão.</p>
            </div>
        </div>
        <div class="panel-body">
            <form method="POST" action="/pedidos/cadastrar">
                <div class="form-grid">
                    <div class="form-group">
                        <label for="numero">Número da partida</label>
                        <input type="text" name="numero" id="numero" placeholder="Ex.: 001" class="form-control" required>
                    </div>
                    <div class="form-group">
                        <label for="valor">Recompensa (troféus)</label>
                        <input type="text" name="valor" id="valor" placeholder="Ex.: 8" class="form-control" required>
                    </div>
                    <div class="form-group">
                        <label for="clienteId">Jogador do esquadrão</label>
                        <select name="clienteId" id="clienteId" class="form-control" required>
                            <option value="" selected disabled>Selecione um jogador</option>
                            <% clientes.forEach(cliente => { %>
                                <option value="<%= cliente.id %>"><%= cliente.nome %></option>
                            <% }) %>
                        </select>
                    </div>
                </div>
                <div class="form-actions">
                    <button type="submit" class="btn btn-success">+ Registrar partida</button>
                </div>
            </form>
        </div>
    </section>

    <section class="panel">
        <div class="panel-heading">
            <span class="card-icon">🏆</span>
            <div>
                <h2>Histórico de partidas</h2>
                <p>Confrontos registrados na arena.</p>
            </div>
        </div>
        <div class="panel-body table-wrap">
            <table class="table table-hover">
                <thead>
                    <tr><th></th><th>Partida</th><th>Recompensa</th><th>Jogador</th><th>ID de jogador</th></tr>
                </thead>
                <tbody>
                    <% if (pedidos.length === 0) { %>
                        <tr><td colspan="5" class="empty-state">Nenhuma partida registrada. A próxima vitória pode ser sua!</td></tr>
                    <% } %>
                    <% pedidos.forEach(pedido => { %>
                        <tr>
                            <td><img src="imgs/order.png" class="table-icon" alt=""></td>
                            <td>#<%= pedido.numero %></td>
                            <td>🏆 <%= Number(pedido.valor).toLocaleString('pt-br', { maximumFractionDigits: 2 }) %></td>
                            <td><%= pedido.cliente.nome %></td>
                            <td><%= pedido.cliente.cpf %></td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </section>
</main>

<%- include ('partials/footer.ejs') %>
