<%- include ('partials/header.ejs') %>
<%- include ('partials/navbar.ejs') %>

<main class="page-shell">
    <section class="hero">
        <div class="hero-content">
            <span class="eyebrow">★ Central de comando</span>
            <h1>A arena é <span>sua.</span></h1>
            <p>Monte seu esquadrão, conheça os brawlers e prepare-se para a próxima batalha. A glória espera por você!</p>
            <a class="btn btn-primary" href="/partidas">⚔️ Ver partidas</a>
            <p class="hero-date currentDate"></p>
        </div>
    </section>

    <div class="section-heading">
        <div>
            <span class="eyebrow">Escolha seu próximo desafio</span>
            <h2>Explore a arena</h2>
        </div>
    </div>
    <section class="arena-grid" aria-label="Seções da arena">
        <a class="arena-card" href="/jogadores">
            <span class="card-icon">🎮</span>
            <h3>Jogadores</h3>
            <p>Conheça quem está pronto para entrar em ação.</p>
        </a>
        <a class="arena-card" href="/brawlers">
            <span class="card-icon">⭐</span>
            <h3>Brawlers</h3>
            <p>Confira os combatentes e suas especialidades.</p>
        </a>
        <a class="arena-card" href="/partidas">
            <span class="card-icon">⚔️</span>
            <h3>Partidas</h3>
            <p>Veja os confrontos e as recompensas da arena.</p>
        </a>
    </section>
</main>

<%- include ('partials/footer.ejs') %>
