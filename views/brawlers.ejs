<%- include ('partials/header.ejs') %>
<%- include ('partials/navbar.ejs') %>

<main class="page-shell">
    <section class="panel">
        <div class="panel-heading">
            <span class="card-icon">⭐</span>
            <div>
                <h1>Descobrir brawler</h1>
                <p>Cadastre um novo combatente para a coleção.</p>
            </div>
        </div>
        <div class="panel-body">
            <form action="/brawlers/cadastrar" method="POST">
                <div class="form-grid">
                    <div class="form-group">
                        <label for="nome">Nome do brawler</label>
                        <input type="text" name="nome" id="nome" placeholder="Ex.: Lenda da arena" class="form-control" required>
                    </div>
                    <div class="form-group">
                        <label for="poder">Poder (moedas)</label>
                        <input type="number" name="poder" id="poder" min="0" step="0.01" placeholder="Ex.: 500" class="form-control" required>
                    </div>
                    <div class="form-group">
                        <label for="classe">Classe</label>
                        <input type="text" name="classe" id="classe" placeholder="Ex.: Destruidor" class="form-control" required>
                    </div>
                </div>
                <div class="form-actions">
                    <button type="submit" class="btn btn-success">+ Adicionar brawler</button>
                    <button type="reset" class="btn btn-secondary">Limpar</button>
                </div>
            </form>
        </div>
    </section>

    <section class="panel">
        <div class="panel-heading">
            <span class="card-icon">💥</span>
            <div>
                <h2>Coleção de brawlers</h2>
                <p>Combatentes disponíveis para entrar na batalha.</p>
            </div>
        </div>
        <div class="panel-body table-wrap">
            <table class="table table-hover">
                <thead>
                    <tr><th></th><th>Brawler</th><th>Poder</th><th>Classe</th><th>Ações</th></tr>
                </thead>
                <tbody>
                    <% if (brawlers.length === 0) { %>
                        <tr><td colspan="5" class="empty-state">Sua coleção está vazia. Adicione seu primeiro brawler!</td></tr>
                    <% } %>
                    <% brawlers.forEach(brawler => { %>
                        <tr>
                            <td><img src="imgs/product.png" class="table-icon" alt=""></td>
                            <td><%= brawler.nome %></td>
                            <td>🪙 <%= Number(brawler.poder).toLocaleString('pt-br', { maximumFractionDigits: 2 }) %></td>
                            <td><%= brawler.classe %></td>
                            <td>
                                <div class="table-actions">
                                    <a href="/brawlers/<%= brawler.id %>/editar" class="btn btn-secondary">Editar</a>
                                    <form action="/brawlers/<%= brawler.id %>/excluir" method="POST" onsubmit="return confirm('Tem certeza que deseja excluir este brawler?')">
                                        <button type="submit" class="btn btn-danger">Excluir</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </section>
</main>

<%- include ('partials/footer.ejs') %>
